#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "helpers.glsl"
#include "wall_boundary.glsl"
#ifdef DEEP_WALL_SKIP
#include "deep_wall_skip.glsl"
#endif

// ============================================================================
// density.comp - δ-plus WCSPH density + pressure update (stage 4 of leapfrog).
//
// Consumes self's correction output (M^-1) and current-step density
// (density_pressure, the canonical buffer). Runs a 27-voxel neighbor loop per particle to
// compute:
//   density_drift     = Σ_j  -ρ_i · V_j · (v_j - v_i) · ∇W̃_ij
//   density_diffusion = Σ_j   δ · h · c₀ · D_ij           (Antuono δ-SPH)
//   D_ij              = 2 · ψ_ij · (-x_ij · ∇W̃_ij) / (r² + ε_h²) · V_j
//   ψ_ij              = ρ_j - ρ_i   (linear form; the full δ-plus ψ_ij is
//                                    written out at the diffusion block)
//
//   ∇W̃_ij = M_i · ∇W_ij   (KCG-corrected gradient, using self's correction)
//   x_ij   = r_i - r_j
//
// Forward integration: ρ_{n+1} = ρ_n + dt · (drift + diffusion)
// EOS:                 P_{n+1} = eos_constant · ((ρ_{n+1}/ρ₀)^γ - 1)
//
// Writes to density_pressure_scratch (binding 2). The simulator's step cmd
// then issues a vkCmdCopyBuffer scratch → primary inside the same submission,
// so by force.comp the canonical density_pressure holds ρ_{n+1}, P_{n+1}.
// No descriptor parity / ping-pong.
//
// Indexing: 1-based throughout. particle_id ∈ [1, OWN+LEADING+TRAILING],
// voxel_id ∈ [1, EXTENDED_VOXEL_COUNT], slot entries are direct 1-based pids.
//
// V1 merged-buffer scheme: own + ghost share set 0 / set 1. Self dispatch
// is bounded to the own pid range via own_first_pid() / own_last_pid().
// Neighbor iteration uses in_own_grid (extended) so ghost neighbors are
// visible automatically.
//
// V1 freshness summary under Option B (single sync after update_voxel +
// ghost_send) at density.comp time:
//   position / velocity / mass / material  : step t  (own + ghost agree)
//   density (ρ)                              : step t-1 (own + ghost agree;
//                                              this kernel is ABOUT to write
//                                              step t)
//   correction_inverse                       : own = step t (correction.comp
//                                              just wrote it),
//                                              GHOST = step t-1 (peer hadn't
//                                              run correction.comp yet at
//                                              ghost_send time)
//   density_gradient_kernel_sum              : own = step t, ghost = step t-1
//
// Self uses its own correction (step t fresh) for `corrected_gradient`. No
// neighbour's correction output (M_j^-1, ∇ρ_j) and no ∇ρ at all is read: the
// only consumer would be the second term of the full ψ_ij, which is not
// implemented (see the diffusion block). So ghost staleness of the correction
// outputs cannot enter this kernel, and in phase B a column's density needs
// only its own L plus its neighbours' r, v, m, ρ_n and material.
// ============================================================================

layout(local_size_x_id = 51, local_size_y = 1, local_size_z = 1) in;

// ============================================================================
// Main
// ============================================================================
void process_particle(uint self_particle_id) {
    // 0-based invocation → 1-based particle_id, offset into own pid range.

    // Read material params (used for EOS at end) and skip inlet particles
    // (their state has no SPH meaning; they never appear as neighbors per the
    // InsideParticleIndexBuffer invariants in common.glsl).
    uint self_group_id = material[self_particle_id];
    MaterialParameters self_params = material_parameters[self_group_id];
    if (self_params.kind == MATERIAL_INLET) return;
    // wall_boundary adami: walls do not integrate density; wall_extrapolate.comp writes their (rho0, p_w) to scratch
    // and primary after this kernel. A fluid particle's wall neighbours below enter with the stored rho0 and their
    // stored, prescribed velocity, as with simple.
    if (WALL_ADAMI && self_params.kind == MATERIAL_BOUNDARY) return;

    // --- Read self state -----------------------------------------------------
    vec4  self_position_voxel_id = position_voxel_id[self_particle_id];
    vec3  self_position          = self_position_voxel_id.xyz;
    uint  self_voxel_id          = uint(round(self_position_voxel_id.w));
    if (self_voxel_id == VOXEL_ID_DEAD) return;

    // --- V4 Path A+ interior/boundary early-return ---------------------------
    // Density's deep-interior pipeline runs in Phase B concurrently with
    // transfer DMA (readback + worker memcpy + upload). To stay correct it
    // skips every particle whose inputs are not final yet: its own L (final
    // outside correction's band) and its neighbours' r, v, m, ρ_n, material
    // (final from own column 2 on: this frame's migrants land in column 0 and
    // the ghosts arrive in Phase C). No neighbour correction output is read,
    // so NEIGHBOR_X_RANGE for density variants must be ≥ correction's band
    // (simulator: V7_BAND_WIDTHS; the default 3 = correction's 2 + 1 dates
    // from the commented-out ψ_ij term that read the neighbours' M_j, ∇ρ_j).
    // Default DENSITY_MODE = ALL preserves V1 single-pipeline behavior.
    ivec3 self_voxel_coord = own_coord_of(self_voxel_id);
    bool self_in_boundary_band = in_boundary_band(self_voxel_coord);
    if (DENSITY_MODE == PIPELINE_MODE_INTERIOR &&  self_in_boundary_band) return;
    if (DENSITY_MODE == PIPELINE_MODE_BOUNDARY && !self_in_boundary_band) return;

#ifdef DEEP_WALL_SKIP
    // E39 B4 (V7_DEEP_WALL_SKIP, deep_wall_skip.glsl): every particle listed in
    // this wall's 3^d voxels is a wall, so the loop below would only take its
    // wall-wall `continue`: skip it. drift and diffusion stay 0 and the
    // epilogue writes the same scratch value as the full loop.
    bool deep_wall_skip = deep_wall_voxel_skippable(self_voxel_coord, self_voxel_id)
                       && self_params.kind == MATERIAL_BOUNDARY;
    if (deep_wall_skip) {
        deep_wall_on_skip(self_particle_id, self_position, self_voxel_coord, DEEP_WALL_KERNEL_DENSITY);
    }
#endif

    vec3  self_velocity = velocity_mass[self_particle_id].xyz;
    float self_stored_density = density_pressure[self_particle_id].x;   // ρ_n (V7_DELTA_DENSITY: ρ_n - ρ_ref)
    float self_density  = density_from_stored(self_stored_density);

    // KCG correction matrix from correction.comp output (self only).
    // When USE_KCG_CORRECTION is false (ablation), substitute identity
    // — reduces this kernel to plain δ-SPH (Antuono 2012) without the kernel
    // gradient correction. The branch is on a spec constant, so glslc -O
    // dead-code-eliminates one side at compile time (no runtime cost).
    mat3 self_correction_matrix;
    if (USE_KCG_CORRECTION) {
        self_correction_matrix = unpack_correction_inverse(self_particle_id);
    } else {
        self_correction_matrix = mat3(1.0);
    }

    // (self_voxel_coord already decoded above for boundary-band check)

    // --- Accumulators --------------------------------------------------------
    float density_drift     = 0.0;
    float density_diffusion = 0.0;

    int neighbor_z_range = int(NEIGHBOR_Z_RANGE);

    // ------------------------------------------------------------------------
    // 27-voxel neighbor loop (9 in 2D).
    // ------------------------------------------------------------------------
    // Innermost loop follows the fastest-varying axis of the x-slowest
    // voxel_id encoding (y), so consecutive neighbor voxels are adjacent
    // in memory. Measured 2026-09-23 on RTX 5090: with dx innermost,
    // density and force ran 5-7% slower than the x-fastest V0 layout.
#ifdef DEEP_WALL_SKIP
    if (!deep_wall_skip)
#endif
    for (int delta_x = -1; delta_x <= 1; delta_x++) {
        for (int delta_z = -neighbor_z_range; delta_z <= neighbor_z_range; delta_z++) {
            for (int delta_y = -1; delta_y <= 1; delta_y++) {
                ivec3 neighbor_coord = self_voxel_coord + ivec3(delta_x, delta_y, delta_z);
                if (!in_own_grid(neighbor_coord)) continue;

                uint neighbor_voxel_id = own_voxel_id_of(neighbor_coord);
                uint neighbor_voxel_particle_count = inside_particle_count[neighbor_voxel_id];

                for (uint slot_index = 0u; slot_index < neighbor_voxel_particle_count; slot_index++) {
                    uint neighbor_particle_id = inside_particle_index[neighbor_voxel_id * MAX_PARTICLES_PER_VOXEL + slot_index];
                    if (neighbor_particle_id == INSIDE_SLOT_EMPTY) break;
                    if (neighbor_particle_id == self_particle_id) continue;

                    // Skip boundary↔boundary pair when self is boundary. The
                    // boundary's per-step new_density (and the new_pressure
                    // derived from it via EOS) should reflect ONLY fluid
                    // neighbor influence, not artifacts from other boundaries
                    // — those are static and contribute zero divergence but
                    // their kernel-deficient drift terms still feed back into
                    // the boundary's apparent pressure. Branch is uniform per
                    // workgroup since voxel-sorted boundaries cluster together.
                    if (self_params.kind == MATERIAL_BOUNDARY) {
                        uint neighbor_group_id = material[neighbor_particle_id];
                        if (material_parameters[neighbor_group_id].kind == MATERIAL_BOUNDARY) continue;
                    }

                    // --- Distance check (Wendland C4 support = h) -----------
                    // Neighbor is guaranteed non-inlet / non-dead by InsideParticleIndexBuffer invariants.
                    vec3  neighbor_position = position_voxel_id[neighbor_particle_id].xyz;
                    vec3  position_difference_neighbor_to_self = self_position - neighbor_position; // x_ij
                    float distance = length(position_difference_neighbor_to_self);
                    if (distance >= SMOOTHING_LENGTH || distance < 1e-12) continue;

                    // --- Read neighbor state --------------------------------
                    vec3  neighbor_velocity = velocity_mass[neighbor_particle_id].xyz;
                    float neighbor_mass     = velocity_mass[neighbor_particle_id].w;
                    float neighbor_stored_density = density_pressure[neighbor_particle_id].x;
                    float neighbor_volume   = neighbor_mass / density_from_stored(neighbor_stored_density);

                    // --- Kernel gradient: raw then M_i-corrected ------------
                    vec3 raw_gradient        = evaluate_kernel_gradient(position_difference_neighbor_to_self, distance);
                    vec3 corrected_gradient  = self_correction_matrix * raw_gradient;

                    // --- δ-SPH density diffusion (gated by USE_DENSITY_DIFFUSION) -
                    // Spec-const branch: glslc -O DCE-removes the entire body when
                    // USE_DENSITY_DIFFUSION = false → vanilla WCSPH continuity.
                    if (USE_DENSITY_DIFFUSION) {
                        // --- ψ_ij ---------------------------------------------------
                        // V0 simplification: ψ_ij = (ρ_j - ρ_i) only (linear form).
                        // Full Antuono δ-plus formulation also includes an antisymmetric
                        // density-gradient projection term that improves accuracy near
                        // sharp density jumps:
                        //   ψ_ij = (ρ_j - ρ_i) - 0.5 · (M_i·∇ρ_i + M_j·∇ρ_j) · (-x_ij)
                        // with M = unpack_correction_inverse() and ∇ρ =
                        // density_gradient_kernel_sum.xyz (correction.comp outputs) of
                        // self AND neighbour. The second term is not implemented: it was
                        // commented out since V0 and its inputs were dead code (compiled
                        // away by glslc -O); E26 (2026-10-05) removed them from the
                        // source. Restoring it reads every neighbour's M_j and ∇ρ_j:
                        //   - ghost neighbours' M_j / ∇ρ_j are one step stale under the
                        //     single sync (a ~1e-4 error in ψ_ij) unless they are
                        //     transported fresh (Option D double sync, V1.0a/V1.1);
                        //   - in Phase B a column's density then needs its neighbours'
                        //     final L, so density's band must again be ≥ correction's
                        //     band + 1 (V7_BAND_WIDTHS 2,3,4; 2,2,3 would be wrong).
                        vec3 position_difference_self_to_neighbor = -position_difference_neighbor_to_self; // -x_ij
                        float psi_ij = neighbor_stored_density - self_stored_density;

                        // --- D_ij = 2·ψ_ij · (-x_ij · ∇W̃_ij) / (r² + ε_h²) · V_j ---
                        float dot_xji_gradient = dot(position_difference_self_to_neighbor, corrected_gradient);
                        float d_ij = 2.0 * psi_ij * dot_xji_gradient / (distance * distance + EPS_H_SQUARED) * neighbor_volume;

                        // --- Diffusion accumulator: δ · h · c₀ · D_ij ---------
                        density_diffusion += DELTA_COEFFICIENT * SMOOTHING_LENGTH * SPEED_OF_SOUND * d_ij;
                    }

                    // --- Drift: -ρ_i · V_j · (v_j - v_i) · ∇W̃_ij -----------
                    density_drift += -self_density * neighbor_volume * dot(neighbor_velocity - self_velocity, corrected_gradient);
                }
            }
        }
    }

    // ========================================================================
    // Forward integration (full dt; leapfrog only staggers v, not ρ).
    // ========================================================================
    float new_stored_density = self_stored_density + TIMESTEP * (density_drift + density_diffusion);

    // ========================================================================
    // Tait EOS: P = eos_constant · ((ρ/ρ₀)^γ - 1)
    // ========================================================================
    float new_pressure  = tait_pressure(new_stored_density, self_params.rest_density,
                                        self_params.eos_constant);

    // ========================================================================
    // Write to scratch (simulator copies scratch → primary right after this
    // dispatch returns).
    //
    // Boundary handling: store ρ₀ instead of the integrated new_density so that
    // boundary particles' density does NOT accumulate step-to-step (this is
    // what kills the boundary density drift). The pressure stored is still the
    // freshly-computed new_pressure (= EOS(new_density)) — force.comp this step
    // reads it for fluid↔boundary pressure interactions, so the boundary still
    // reacts to local pressure conditions. Next step's density.comp reads back
    // ρ₀ for the boundary source density (no drift), and force.comp computes
    // V_j_boundary = m / ρ₀ = V_calibrated (constant, physically correct for
    // a static solid). Matches the legacy "property buffer = ρ₀ forever,
    // runtime buffer = per-step new_pressure" architecture.
    // ========================================================================
    float density_to_store = (self_params.kind == MATERIAL_BOUNDARY)
        ? stored_rest_density(self_params.rest_density)
        : new_stored_density;
    density_pressure_scratch[self_particle_id] = vec2(density_to_store, new_pressure);
}


// ---------------------------------------------------------------------------
// Entry point (V3.4 / V3.8): derive the self pid(s) for this thread and run the
// per-particle body above. BAND_VOXEL_DISPATCH = 0: one thread per own pool
// slot. BAND_VOXEL_DISPATCH = 1, BAND_SLOT_LANES = 0: thread = (band voxel,
// slot). BAND_SLOT_LANES = L > 0: thread = (band voxel, lane), looping over
// slots lane, lane + L, ... so a warp stays full when a voxel holds far fewer
// particles than MAX_PARTICLES_PER_VOXEL.
// ---------------------------------------------------------------------------
void main() {
    uint thread_id = gl_GlobalInvocationID.x;
    if (BAND_VOXEL_DISPATCH == 2u) {
        // V7_BAND_COMPACT_DISPATCH: thread = entry of the compacted band list
        uint self_particle_id;
        if (compact_thread_particle(thread_id, NEIGHBOR_X_RANGE, self_particle_id)) {
            process_particle(self_particle_id);
        }
        return;
    }
    if (BAND_VOXEL_DISPATCH == 1u) {
        if (BAND_SLOT_LANES == 0u) {
            uint self_particle_id;
            if (band_thread_particle(thread_id, NEIGHBOR_X_RANGE, self_particle_id)) {
                process_particle(self_particle_id);
            }
            return;
        }
        uint voxel_id;
        if (!band_thread_voxel(thread_id / BAND_SLOT_LANES, NEIGHBOR_X_RANGE, voxel_id)) return;
        uint count = inside_particle_count[voxel_id];
        for (uint slot = thread_id % BAND_SLOT_LANES; slot < count; slot += BAND_SLOT_LANES) {
            process_particle(inside_particle_index[voxel_id * MAX_PARTICLES_PER_VOXEL + slot]);
        }
        return;
    }
    uint self_particle_id = thread_id + own_first_pid();
    if (self_particle_id > own_last_pid()) return;
    process_particle(self_particle_id);
}
