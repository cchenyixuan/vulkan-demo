#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=11:00:00
#SBATCH -J e7_A
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_A1_%j.out
# E7 full campaign, job A1 of line A (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 4.86 h (16 items); the protocol is e7_lib.sh's, the model e7_plan.py's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin A1 A cavity2d_n1000 cavity2d_n1440 cavity2d_n2000 cavity2d_n240 cavity2d_n2840 cavity2d_n360 cavity2d_n4000 cavity2d_n520 cavity2d_n5640 cavity2d_n720 cavity2d_n8000 cavity3d_n160_k8 cavity3d_n200_k8
e7_precheck cavity2d_n8000 k1 4 50 900
e7_precheck cavity3d_n160_k8 k1 4 50 900
e7_precheck cavity3d_n200_k8 k1 4 50 900
e7_point F2 cavity2d_n5640 2 3 3000 1000 1020 900 960 2 same:1020
e7_point F2+F7 cavity2d_n5640 4 3 3000 1000 1140 900 960 2 same:1020
e7_point F2 cavity2d_n8000 2 3 3000 1000 1200 1020 1200 2 same:1320
e7_point F2 cavity2d_n8000 4 3 3000 1000 1320 900 1140 2 same:1320
e7_point F7 cavity2d_n240 2 5 3000 1000 900 900 900 2 same:900
e7_point F7 cavity2d_n520 2 5 3000 1000 900 900 900 2 same:900
e7_point F7 cavity2d_n1000 2 5 3000 1000 900 900 900 2 same:900
e7_point F7 cavity2d_n2000 2 5 3000 1000 900 900 900 2 same:900
e7_point F7 cavity2d_n4000 2 3 3000 1000 960 900 900 2 same:900
e7_point F7 cavity2d_n360 4 5 3000 1000 1020 900 900 2 same:900
e7_point F7 cavity2d_n720 4 5 3000 1000 1020 900 900 2 same:900
e7_point F7 cavity2d_n1440 4 5 3000 1000 1020 900 900 2 same:900
e7_point F7 cavity2d_n2840 4 5 3000 1000 1020 900 900 2 same:900
e7_job_end
