#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=07:00:00
#SBATCH -J e7_B
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_b3B_%j.out
# E7 full campaign, batch 3, line B (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 2.83 h, 2 items: F4+F5, F6. The protocol is e7_lib.sh's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b3B B cavity2d_n1000 cavity3d_n200 cavity3d_n200_k8 cavity3d_n416
e7_point F4+F5 cavity3d_n200_k8 8 3 1500 500 1680 1020 1440 2 cavity3d_n200:900 same:2100
e7_point F6 cavity3d_n416 8 3 1500 500 1740 1020 1500 2 same:2220
e7_job_end
