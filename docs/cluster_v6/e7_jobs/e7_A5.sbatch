#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=04:00:00
#SBATCH -J e7_A
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_A5_%j.out
# E7 full campaign, job A5 of line A (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 1.07 h (2 items); the protocol is e7_lib.sh's, the model e7_plan.py's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin A5 A cavity2d_n1000 cavity2d_n4000 cavity2d_n8000
e7_cross B F1+F7 cavity2d_n4000 8 3 3000 1000 1380 900 1080 0 same:900
e7_cross B F1+F7 cavity2d_n8000 8 3 3000 1000 1560 900 1200 0 same:1320
e7_job_end
