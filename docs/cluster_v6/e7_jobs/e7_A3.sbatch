#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=07:00:00
#SBATCH -J e7_A
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_A3_%j.out
# E7 full campaign, job A3 of line A (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 2.63 h (7 items); the protocol is e7_lib.sh's, the model e7_plan.py's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin A3 A cavity2d_n1000 cavity3d_n104_b9 cavity3d_n160 cavity3d_n160_k2 cavity3d_n160_k4 cavity3d_n200 cavity3d_n200_b9 cavity3d_n200_k2 cavity3d_n200_k4 cavity3d_n200_x96
e7_point F4 cavity3d_n160_k2 2 3 1500 500 960 900 900 2 cavity3d_n160:900
e7_point F4 cavity3d_n160_k4 4 3 1500 500 1140 900 960 2 cavity3d_n160:900
e7_point F4 cavity3d_n200_k2 2 3 1500 500 1020 900 960 2 cavity3d_n200:900
e7_point F4 cavity3d_n200_k4 4 3 1500 500 1260 900 1140 2 cavity3d_n200:900
e7_point F8 cavity3d_n104_b9 2 5 1500 500 900 900 900 2 same:900
e7_point F8 cavity3d_n200_b9 2 3 1500 500 960 900 900 2 same:900
e7_point F8 cavity3d_n200_x96 2 5 1500 500 900 900 900 2 same:900
e7_job_end
