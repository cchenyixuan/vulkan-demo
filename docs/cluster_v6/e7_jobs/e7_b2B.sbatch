#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=14:00:00
#SBATCH -J e7_B
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_b2B_%j.out
# E7 full campaign, batch 2, line B (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 6.37 h, 9 items: F1, F1+F7, F3. The protocol is e7_lib.sh's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b2B B cavity2d_n1000 cavity2d_n1440 cavity2d_n1440_k8 cavity2d_n2000 cavity2d_n2000_k8 cavity2d_n2840 cavity2d_n2840_k8 cavity2d_n4000 cavity2d_n4000_k8 cavity2d_n5640 cavity2d_n5640_k8 cavity2d_n9000
e7_point F1+F7 cavity2d_n2000 8 5 3000 1000 1320 900 1020 2 same:900
e7_point F1 cavity2d_n2840 8 5 3000 1000 1320 900 1020 2 same:900
e7_point F1 cavity2d_n5640 8 5 3000 1000 1440 900 1080 2 same:1020
e7_point F1 cavity2d_n9000 8 3 3000 1000 1620 960 1260 2 same:1440
e7_point F3 cavity2d_n1440_k8 8 5 3000 1000 1380 900 1080 2 cavity2d_n1440:900
e7_point F3 cavity2d_n2000_k8 8 5 3000 1000 1440 900 1080 2 cavity2d_n2000:900
e7_point F3 cavity2d_n2840_k8 8 3 3000 1000 1560 900 1200 2 cavity2d_n2840:900
e7_point F3 cavity2d_n4000_k8 8 3 3000 1000 1800 1080 1440 2 cavity2d_n4000:900
e7_point F3 cavity2d_n5640_k8 8 3 3000 1000 2340 1440 1920 2 cavity2d_n5640:1020
e7_job_end
