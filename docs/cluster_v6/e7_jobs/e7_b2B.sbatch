#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=05:00:00
#SBATCH -J e7_B
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_b2B_%j.out
# E7 full campaign, batch 2, line B (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 1.74 h, 8 items: F1, F1+F7, F3, F7, anatomy. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-c56d07863dd3}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-rc2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-a4b3a8318a83805a00b255f8d8d0eb682903b09c}
export E7_ARMS=${E7_ARMS:-C}
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc2}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b2B B cavity2d_n1000 cavity2d_n11320 cavity2d_n1440 cavity2d_n1440_k8 cavity2d_n2840 cavity2d_n2840_k8 cavity2d_n520 cavity2d_n5640 cavity2d_n5640_k8 cavity2d_n8000
e7_point F1 cavity2d_n11320 8 3 1500 500 1260 960 1080 1 pairs:1140
e7_point F7 cavity2d_n520 8 3 1500 500 900 900 900 1 same:900
e7_point F7 cavity2d_n1000 8 3 1500 500 900 900 900 1 same:900
e7_point F3 cavity2d_n1440_k8 8 3 1500 500 900 900 900 0 cavity2d_n1440:900
e7_point F3 cavity2d_n2840_k8 8 3 1500 500 960 900 900 0 cavity2d_n2840:900
e7_point F3 cavity2d_n5640_k8 8 3 1500 500 1800 1260 1440 0 cavity2d_n5640:900
e7_cross B F1+F7 cavity2d_n8000 8 3 1500 500 960 900 900 1 same:1020
e7_extra anatomy anatomy_2d_n8000_K8 cavity2d_n8000 8 3000 500 900
e7_job_end
