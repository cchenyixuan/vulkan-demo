#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=02:00:00
#SBATCH -J e7_B10
#SBATCH --dependency=singleton
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --exclude=wqd10nbm13g5,wqd10nah09g1
#SBATCH -o /data/run01/scxm138/logs/e7_b2AB_%j.out
# E7 full campaign, batch 14, line B (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 0.48 h, 2 items: F3. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-c56d07863dd3}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-rc2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-a4b3a8318a83805a00b255f8d8d0eb682903b09c}
export E7_ARMS=${E7_ARMS:-C}
export E7_REFERENCE_SPREAD_PCT=${E7_REFERENCE_SPREAD_PCT:-3}
export E7_UNIFORM_POWER_CAP=${E7_UNIFORM_POWER_CAP:-1}
export E7_POWER_CAP_W=${E7_POWER_CAP_W:-575}
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc2}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b2AB B cavity2d_n1000 cavity2d_n2840 cavity2d_n2840_k5
e7_point F3 cavity2d_n2840_k5 5 3 1500 500 1260 900 1020 1 cavity2d_n2840:900
E7_PREFIX=old_ E7_WEIGHTS_FROM=$HOME/run/logs/e7_b2Y_1704741/weights/2d_n2840_k5_K5.json E7_WEIGHTS_SHA256=d2e283170ae51618b724c96bb2c5615259deb19e42d7233ba15e75a4968c4f5f e7_point F3 cavity2d_n2840_k5 5 3 1500 500 900 900 1020 1 cavity2d_n2840:900
e7_job_end
