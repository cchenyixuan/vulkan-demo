#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=09:00:00
#SBATCH -J e7_B
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_b1B_%j.out
# E7 full campaign, batch 1, line B (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 3.70 h, 12 items: F1, F1+F7, F4+F5, precheck, selftest, soak. The protocol is e7_lib.sh's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b1B B cavity2d_n1000 cavity2d_n11320 cavity2d_n4000 cavity2d_n8000 cavity2d_n9000 cavity3d_n160 cavity3d_n160_k8 cavity3d_n200_k8 cavity3d_n416
e7_extra selftest selftest_2d_n1000_K8 cavity2d_n1000 8 1000 200 960
e7_precheck cavity2d_n8000 k1 8 50 900
e7_precheck cavity2d_n9000 k1 8 50 900
e7_precheck cavity3d_n160_k8 k1 8 50 900
e7_precheck cavity3d_n200_k8 k1 8 50 900
e7_precheck cavity3d_n416 k1 8 50 900
e7_precheck cavity2d_n11320 pairs 4 50 960
e7_point F1+F7 cavity2d_n8000 8 3 3000 1000 1560 900 1200 2 same:1320
e7_point F1+F7 cavity2d_n4000 8 5 3000 1000 1380 900 1080 2 same:900
e7_point F1 cavity2d_n11320 8 3 3000 1000 1800 1080 1440 2 pairs:1500
e7_point F4+F5 cavity3d_n160_k8 8 3 1500 500 1500 900 1200 2 cavity3d_n160:900 same:1440
e7_extra soak soak_2d_n8000_K8 cavity2d_n8000 8 17000 1000 1500
e7_job_end
