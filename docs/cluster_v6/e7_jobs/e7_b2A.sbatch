#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=07:00:00
#SBATCH -J e7_A
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_b2A_%j.out
# E7 full campaign, batch 2, line A (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 2.61 h, 9 items: F2, F2+F7, F3. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-c56d07863dd3}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-rc2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-a4b3a8318a83805a00b255f8d8d0eb682903b09c}
export E7_ARMS=${E7_ARMS:-C}
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc2}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b2A A cavity2d_n1000 cavity2d_n1440 cavity2d_n1440_k4 cavity2d_n2840 cavity2d_n2840_k2 cavity2d_n2840_k4 cavity2d_n5640 cavity2d_n5640_k2 cavity2d_n5640_k4 cavity2d_n8000
e7_point F2 cavity2d_n5640 2 3 3000 1000 900 900 900 1 same:960
e7_point F2+F7 cavity2d_n5640 4 3 3000 1000 900 900 900 1 same:960
e7_point F2 cavity2d_n8000 2 3 3000 1000 960 1020 1080 1 same:1260
e7_point F2 cavity2d_n8000 4 3 3000 1000 960 900 960 1 same:1260
e7_point F3 cavity2d_n1440_k4 4 3 3000 1000 900 900 900 0 cavity2d_n1440:900
e7_point F3 cavity2d_n2840_k2 2 3 3000 1000 900 900 900 0 cavity2d_n2840:900
e7_point F3 cavity2d_n2840_k4 4 3 3000 1000 900 900 900 0 cavity2d_n2840:900
e7_point F3 cavity2d_n5640_k2 2 3 3000 1000 960 1020 1080 0 cavity2d_n5640:960
e7_point F3 cavity2d_n5640_k4 4 3 3000 1000 1260 1140 1260 0 cavity2d_n5640:960
e7_job_end
