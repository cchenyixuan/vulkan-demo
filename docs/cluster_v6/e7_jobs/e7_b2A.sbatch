#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=13:00:00
#SBATCH -J e7_A
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_b2A_%j.out
# E7 full campaign, batch 2, line A (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 5.66 h, 11 items: F2, F2+F7, F3. The protocol is e7_lib.sh's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b2A A cavity2d_n1000 cavity2d_n1440 cavity2d_n1440_k4 cavity2d_n2000 cavity2d_n2000_k2 cavity2d_n2000_k4 cavity2d_n2840 cavity2d_n2840_k2 cavity2d_n4000 cavity2d_n4000_k2 cavity2d_n4000_k4 cavity2d_n5640 cavity2d_n5640_k2 cavity2d_n5640_k4 cavity2d_n8000
e7_point F2 cavity2d_n5640 2 3 3000 1000 1020 900 960 2 same:1020
e7_point F2+F7 cavity2d_n5640 4 3 3000 1000 1140 900 960 2 same:1020
e7_point F2 cavity2d_n8000 2 3 3000 1000 1200 1020 1200 2 same:1320
e7_point F3 cavity2d_n1440_k4 4 5 3000 1000 1020 900 900 2 cavity2d_n1440:900
e7_point F3 cavity2d_n2000_k2 2 5 3000 1000 900 900 900 2 cavity2d_n2000:900
e7_point F3 cavity2d_n2000_k4 4 5 3000 1000 1080 900 900 2 cavity2d_n2000:900
e7_point F3 cavity2d_n2840_k2 2 3 3000 1000 960 900 900 2 cavity2d_n2840:900
e7_point F3 cavity2d_n4000_k2 2 3 3000 1000 1020 900 960 2 cavity2d_n4000:900
e7_point F3 cavity2d_n4000_k4 4 3 3000 1000 1320 900 1140 2 cavity2d_n4000:900
e7_point F3 cavity2d_n5640_k2 2 3 3000 1000 1200 1020 1200 2 cavity2d_n5640:1020
e7_point F3 cavity2d_n5640_k4 4 3 3000 1000 1560 1200 1440 2 cavity2d_n5640:1020
e7_job_end
