#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=07:00:00
#SBATCH -J e7_B
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_b4B_%j.out
# E7 full campaign, batch 4, line B (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 2.90 h, 7 items: F2, F7, anatomy, soak. The protocol is e7_lib.sh's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b4B B cavity2d_n1000 cavity2d_n2840 cavity2d_n520 cavity2d_n8000 cavity3d_n416
e7_point F7 cavity2d_n520 8 5 3000 1000 1320 900 1020 2 same:900
e7_point F7 cavity2d_n1000 8 5 3000 1000 1320 900 1020 2 same:900
e7_extra anatomy anatomy_2d_n8000_K1 cavity2d_n8000 1 3000 1000 1320
e7_extra anatomy anatomy_2d_n8000_K8 cavity2d_n8000 8 3000 1000 1140
e7_cross A F7 cavity2d_n2840 4 3 3000 1000 1020 900 900 0 same:900
e7_cross A F2 cavity2d_n8000 4 3 3000 1000 1320 900 1140 0 same:1320
e7_extra soak soak_3d_n416_K8 cavity3d_n416 8 55000 500 8520
e7_job_end
