#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=09:00:00
#SBATCH -J e7_A
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_b4A_%j.out
# E7 full campaign, batch 4, line A (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 3.91 h, 14 items: F1+F7, F7, F8. The protocol is e7_lib.sh's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b4A A cavity2d_n1000 cavity2d_n1440 cavity2d_n2000 cavity2d_n240 cavity2d_n2840 cavity2d_n360 cavity2d_n4000 cavity2d_n520 cavity2d_n720 cavity2d_n8000 cavity3d_n104_b9 cavity3d_n200_b9 cavity3d_n200_x96
e7_point F7 cavity2d_n240 2 5 3000 1000 900 900 900 2 same:900
e7_point F7 cavity2d_n520 2 5 3000 1000 900 900 900 2 same:900
e7_point F7 cavity2d_n1000 2 5 3000 1000 900 900 900 2 same:900
e7_point F7 cavity2d_n2000 2 5 3000 1000 900 900 900 2 same:900
e7_point F7 cavity2d_n4000 2 3 3000 1000 960 900 900 2 same:900
e7_point F7 cavity2d_n360 4 5 3000 1000 1020 900 900 2 same:900
e7_point F7 cavity2d_n720 4 5 3000 1000 1020 900 900 2 same:900
e7_point F7 cavity2d_n1440 4 5 3000 1000 1020 900 900 2 same:900
e7_point F7 cavity2d_n2840 4 5 3000 1000 1020 900 900 2 same:900
e7_point F8 cavity3d_n104_b9 2 5 1500 500 900 900 900 2 same:900
e7_point F8 cavity3d_n200_b9 2 3 1500 500 960 900 900 2 same:900
e7_point F8 cavity3d_n200_x96 2 5 1500 500 900 900 900 2 same:900
e7_cross B F1+F7 cavity2d_n4000 8 3 3000 1000 1380 900 1080 0 same:900
e7_cross B F1+F7 cavity2d_n8000 8 3 3000 1000 1560 900 1200 0 same:1320
e7_job_end
