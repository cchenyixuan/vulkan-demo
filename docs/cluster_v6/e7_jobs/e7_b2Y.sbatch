#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=06:00:00
#SBATCH -J e7_A
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_b2Y_%j.out
# E7 full campaign, batch 11, line A (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 2.25 h, 11 items: F3. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-c56d07863dd3}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-rc2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-a4b3a8318a83805a00b255f8d8d0eb682903b09c}
export E7_ARMS=${E7_ARMS:-C}
export E7_REFERENCE_SPREAD_PCT=${E7_REFERENCE_SPREAD_PCT:-3}
export E7_UNIFORM_POWER_CAP=${E7_UNIFORM_POWER_CAP:-1}
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc2}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b2Y A cavity2d_n1000 cavity2d_n1440 cavity2d_n1440_k6 cavity2d_n1440_k7 cavity2d_n1440_k8 cavity2d_n2840 cavity2d_n2840_k3 cavity2d_n2840_k5 cavity2d_n2840_k6 cavity2d_n2840_k7 cavity2d_n5640 cavity2d_n5640_k3 cavity2d_n5640_k5 cavity2d_n5640_k6 cavity2d_n5640_k7
e7_point F3 cavity2d_n1440_k6 6 5 1500 500 900 900 900 0 cavity2d_n1440:900
e7_point F3 cavity2d_n1440_k7 7 5 1500 500 900 900 900 0 cavity2d_n1440:900
e7_point F3 cavity2d_n2840_k3 3 3 1500 500 900 900 900 0 cavity2d_n2840:900
e7_point F3 cavity2d_n2840_k5 5 3 1500 500 900 900 900 0 cavity2d_n2840:900
e7_point F3 cavity2d_n2840_k6 6 3 1500 500 900 900 900 0 cavity2d_n2840:900
e7_point F3 cavity2d_n2840_k7 7 3 1500 500 900 900 900 0 cavity2d_n2840:900
e7_point F3 cavity2d_n5640_k3 3 3 1500 500 1080 960 1020 0 cavity2d_n5640:900
e7_point F3 cavity2d_n5640_k5 5 3 1500 500 1380 1080 1200 0 cavity2d_n5640:900
e7_point F3 cavity2d_n5640_k6 6 3 1500 500 1500 1140 1260 0 cavity2d_n5640:900
e7_point F3 cavity2d_n5640_k7 7 3 1500 500 1620 1200 1380 0 cavity2d_n5640:900
e7_point F3 cavity2d_n1440_k8 8 0 1500 500 900 900 900 1 cavity2d_n1440:900
e7_job_end
