#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=03:00:00
#SBATCH -J e7_B9
#SBATCH --dependency=singleton
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --exclude=wqd10nbm13g5,wqd10nah09g1
#SBATCH -o /data/run01/scxm138/logs/e7_b2AA_%j.out
# E7 full campaign, batch 13, line B (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 0.94 h, 8 items: F1, F1+F7, F3, tracegroup. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-c56d07863dd3}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-rc2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-a4b3a8318a83805a00b255f8d8d0eb682903b09c}
export E7_ARMS=${E7_ARMS:-C}
export E7_REFERENCE_SPREAD_PCT=${E7_REFERENCE_SPREAD_PCT:-3}
export E7_UNIFORM_POWER_CAP=${E7_UNIFORM_POWER_CAP:-1}
export E7_POWER_CAP_W=${E7_POWER_CAP_W:-575}
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc2}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b2AA B cavity2d_n1000 cavity2d_n1440 cavity2d_n1440_k8 cavity2d_n4000 cavity2d_n5640 cavity2d_n8000
e7_trace_group reftrace_2d_n8000_K1 cavity2d_n8000 8 1500 500 1140
e7_trace_group reftrace_2d_n5640_K1 cavity2d_n5640 8 1500 500 960
e7_trace_group reftrace_2d_n4000_K1 cavity2d_n4000 8 1500 500 900
e7_trace_group reftrace_2d_n1440_K1 cavity2d_n1440 8 1500 500 900
e7_point F1+F7 cavity2d_n8000 8 0 1500 500 1560 900 1200 1 same:1080
e7_point F1 cavity2d_n5640 8 0 1500 500 1440 900 1080 1 same:900
e7_point F1+F7 cavity2d_n4000 8 0 1500 500 1380 900 1020 1 same:900
e7_point F3 cavity2d_n1440_k8 8 0 1500 500 1380 900 1020 1 cavity2d_n1440:900
e7_job_end
