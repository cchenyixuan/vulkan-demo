#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=04:00:00
#SBATCH -J e7_V
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_v1_%j.out
# E7 validation job v1, line V: rc2 (this deployment) against v7-rc1 (E7_RC1_REPO, read only) (generated by docs/cluster_v6/scripts/e7_plan.py --emit-validation; do not edit by hand).
# Estimate 1.27 h, 4 items: F3 cavity2d_n1440_k2 K=2, F1+F7 cavity2d_n4000 K=8, F1+F7 cavity2d_n8000 K=8 A/B rc1-rc2, F4 cavity3d_n160_k8 K=8 A/B rc1-rc2. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-c56d07863dd3}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-rc2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-a4b3a8318a83805a00b255f8d8d0eb682903b09c}
export E7_RC1_REPO=${E7_RC1_REPO:-$HOME/run/vulkan-demo-v7rc1}
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc2}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin v1 V cavity2d_n1000 cavity2d_n1440 cavity2d_n1440_k2 cavity2d_n4000 cavity2d_n8000 cavity3d_n160 cavity3d_n160_k8
e7_point F3 cavity2d_n1440_k2 2 5 3000 1000 900 900 900 2 cavity2d_n1440:900
e7_point F1+F7 cavity2d_n4000 8 5 3000 1000 900 900 900 2 same:900
e7_pair_point F1+F7 cavity2d_n8000 8 3 3000 1000 960 900 C same:1260
e7_pair_point F4 cavity3d_n160_k8 8 3 1500 500 900 900 C cavity3d_n160:900
e7_job_end
