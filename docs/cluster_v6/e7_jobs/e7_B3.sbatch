#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=09:00:00
#SBATCH -J e7_B
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_B3_%j.out
# E7 full campaign, job B3 of line B (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 3.76 h (3 items); the protocol is e7_lib.sh's, the model e7_plan.py's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin B3 B cavity2d_n1000 cavity3d_n160 cavity3d_n160_k8 cavity3d_n200 cavity3d_n200_k8 cavity3d_n416
e7_point F4+F5 cavity3d_n160_k8 8 3 1500 500 1500 900 1200 2 cavity3d_n160:900 same:1440
e7_point F4+F5 cavity3d_n200_k8 8 3 1500 500 1680 1020 1440 2 cavity3d_n200:900 same:2100
e7_point F6 cavity3d_n416 8 3 1500 500 1740 1020 1500 2 same:2220
e7_job_end
