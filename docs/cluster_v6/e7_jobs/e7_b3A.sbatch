#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=13:00:00
#SBATCH -J e7_A
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_b3A_%j.out
# E7 full campaign, batch 3, line A (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 5.69 h, 7 items: F4, F5. The protocol is e7_lib.sh's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b3A A cavity2d_n1000 cavity3d_n160 cavity3d_n160_k2 cavity3d_n160_k4 cavity3d_n160_k8 cavity3d_n200 cavity3d_n200_k2 cavity3d_n200_k4 cavity3d_n200_k8
e7_point F4 cavity3d_n160_k2 2 3 1500 500 960 900 900 2 cavity3d_n160:900
e7_point F4 cavity3d_n160_k4 4 3 1500 500 1140 900 960 2 cavity3d_n160:900
e7_point F4 cavity3d_n200_k2 2 3 1500 500 1020 900 960 2 cavity3d_n200:900
e7_point F4 cavity3d_n200_k4 4 3 1500 500 1260 900 1140 2 cavity3d_n200:900
e7_point F5 cavity3d_n160_k8 2 3 1500 500 1200 1080 1200 2 same:1440
e7_point F5 cavity3d_n200_k8 2 3 1500 500 1560 1440 1620 2 same:2100
e7_point F5 cavity3d_n200_k8 4 3 1500 500 1500 1140 1440 2 same:2100
e7_job_end
