#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=04:00:00
#SBATCH -J e7_B
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_b2T_%j.out
# E7 full campaign, batch 6, line B (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 1.36 h, 4 items: F2. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-c56d07863dd3}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-rc2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-a4b3a8318a83805a00b255f8d8d0eb682903b09c}
export E7_ARMS=${E7_ARMS:-C}
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc2}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin b2T B cavity2d_n1000 cavity2d_n8000
e7_point F2 cavity2d_n8000 3 3 1500 500 960 900 900 1 same:1020
e7_point F2 cavity2d_n8000 5 3 1500 500 960 900 900 1 same:1020
e7_point F2 cavity2d_n8000 6 3 1500 500 960 900 900 1 same:1020
e7_point F2 cavity2d_n8000 7 3 1500 500 960 900 900 1 same:1020
e7_job_end
