#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=11:00:00
#SBATCH -J e7_A
#SBATCH --dependency=singleton
#SBATCH -o /data/run01/scxm138/logs/e7_A4_%j.out
# E7 full campaign, job A4 of line A (generated by docs/cluster_v6/scripts/e7_plan.py --emit-jobs; do not edit by hand).
# Estimate 4.93 h (4 items); the protocol is e7_lib.sh's, the model e7_plan.py's.
source "${E30_REPO:-$HOME/run/vulkan-demo-v7rc1}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin A4 A cavity2d_n1000 cavity3d_n160_k8 cavity3d_n200_k8
e7_point F5 cavity3d_n160_k8 2 3 1500 500 1200 1080 1200 2 same:1440
e7_point F5 cavity3d_n160_k8 4 3 1500 500 1260 900 1140 2 same:1440
e7_point F5 cavity3d_n200_k8 2 3 1500 500 1560 1440 1620 2 same:2100
e7_point F5 cavity3d_n200_k8 4 3 1500 500 1500 1140 1440 2 same:2100
e7_job_end
