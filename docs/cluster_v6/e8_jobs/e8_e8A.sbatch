#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=07:00:00
#SBATCH -J e8_A
#SBATCH --dependency=singleton
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --exclude=wqd10nbm13g5,wqd10nah09g1
#SBATCH -o /data/run01/scxm138/logs/e8_e8A_%j.out
# E8 phase 2 (user 2026-10-22), 3-D cubic cavity on tag e8-3d-p2 (generated by docs/cluster_v6/scripts/e7_plan.py --revision 11 --emit-jobs, line A; do not edit by hand).
# Estimate 2.57 h, 4 items: E8K, E8W. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-E8P2_COMMIT_AT_SUBMISSION}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-e8p2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-10781f23663c3c3b8c95cbe7235c3fa7653b07aa}
export E7_ARMS=${E7_ARMS:-C}
export E7_RAW=${E7_RAW:-1}
export E7_TRACE_DETAIL=${E7_TRACE_DETAIL:-full}
export E7_CONTINUE_ON_FAILURE=${E7_CONTINUE_ON_FAILURE:-1}
export E7_PARTITION_RECORD=${E7_PARTITION_RECORD:-1}
export E7_UNIFORM_POWER_CAP=${E7_UNIFORM_POWER_CAP:-1}
export E7_POWER_CAP_W=${E7_POWER_CAP_W:-575}
export E8_SINGLE_REPO=${E8_SINGLE_REPO:-$HOME/run/vulkan-demo-v7single}
source "${E30_REPO:-$HOME/run/vulkan-demo-e8}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin e8A A cavity2d_n1000 cavity3d_n192 cavity3d_n192_k2 cavity3d_n192_k4 cavity3d_n392
e7_point E8K cavity3d_n392 2 3 1500 500 1320 1380 1500 1 same:1980
e7_point E8K cavity3d_n392 4 3 1500 500 1140 1080 1260 1 same:1980
e7_point E8W cavity3d_n192_k2 2 3 1500 500 900 900 900 1 cavity3d_n192:900
e7_point E8W cavity3d_n192_k4 4 3 1500 500 900 900 960 1 cavity3d_n192:900
e7_job_end
