#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=02:00:00
#SBATCH -J e8_BS
#SBATCH --dependency=singleton
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --exclude=wqd10nbm13g5,wqd10nah09g1
#SBATCH -o /data/run01/scxm138/logs/e8_e8S_%j.out
# E8 phase 2 re-run of the v7_single comparison (job 1721839's single halves failed on V7_WORKER_AFFINITY), on tag e8-3d-p2s (generated by docs/cluster_v6/scripts/e7_plan.py --revision 13 --emit-jobs, line B; do not edit by hand).
# Estimate 0.25 h, 1 items: single_ratio. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-E8P2S_COMMIT_AT_SUBMISSION}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-e8p2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-10781f23663c3c3b8c95cbe7235c3fa7653b07aa}
export E7_ARMS=${E7_ARMS:-C}
export E7_RAW=${E7_RAW:-1}
export E7_CONTINUE_ON_FAILURE=${E7_CONTINUE_ON_FAILURE:-1}
export E7_UNIFORM_POWER_CAP=${E7_UNIFORM_POWER_CAP:-1}
export E7_POWER_CAP_W=${E7_POWER_CAP_W:-575}
export E8_SINGLE_REPO=${E8_SINGLE_REPO:-$HOME/run/vulkan-demo-v7single}
source "${E30_REPO:-$HOME/run/vulkan-demo-e8s}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin e8S B cavity2d_n1000 cavity3d_n192
e8_single_ratio single_3d_n192 cavity3d_n192 3 1500 500 1860
e7_job_end
