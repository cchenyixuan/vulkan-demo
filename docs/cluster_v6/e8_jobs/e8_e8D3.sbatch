#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=04:00:00
#SBATCH -J e8_BD3
#SBATCH --dependency=singleton
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --exclude=wqd10nbm13g5,wqd10nah09g1,wqd10nbj04g3,wqd10nbj04g5
#SBATCH -o /data/run01/scxm138/logs/e8_e8D3_%j.out
# E8 phase 2 addition e8_D a third time as e8_D3 (jobs 1722854 on wqd10nbj04g3 and 1723582 on wqd10nbj04g5 each lost a GPU in their first reference group after a ~530 W power plateau and measured nothing), the 76M cube (13 columns per card) at K = 8 on tag e8-3d-p2d3 (generated by docs/cluster_v6/scripts/e7_plan.py --revision 17 --emit-jobs, line B; do not edit by hand).
# Estimate 1.40 h, 2 items: F6+E8S, trace. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-E8P2D3_COMMIT_AT_SUBMISSION}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-e8p2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-10781f23663c3c3b8c95cbe7235c3fa7653b07aa}
export E7_ARMS=${E7_ARMS:-C}
export E7_RAW=${E7_RAW:-1}
export E7_TRACE_DETAIL=${E7_TRACE_DETAIL:-full}
export E7_CONTINUE_ON_FAILURE=${E7_CONTINUE_ON_FAILURE:-1}
export E7_PARTITION_RECORD=${E7_PARTITION_RECORD:-1}
export E7_UNIFORM_POWER_CAP=${E7_UNIFORM_POWER_CAP:-1}
export E7_POWER_CAP_W=${E7_POWER_CAP_W:-575}
source "${E30_REPO:-$HOME/run/vulkan-demo-e8d3}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin e8D3 B cavity2d_n1000 cavity3d_n416
e7_point F6+E8S cavity3d_n416 8 3 1500 500 1740 1020 1500 1 same:2220
e7_extra trace trace_3d_n416_K1 cavity3d_n416 1 1500 500 2280
e7_job_end
