#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=08:00:00
#SBATCH -J e8_B
#SBATCH --dependency=singleton
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --exclude=wqd10nbm13g5,wqd10nah09g1
#SBATCH -o /data/run01/scxm138/logs/e8_e8B_%j.out
# E8 phase 2 (user 2026-10-22), 3-D cubic cavity on tag e8-3d-p2 (generated by docs/cluster_v6/scripts/e7_plan.py --revision 11 --emit-jobs, line B; do not edit by hand).
# Estimate 3.11 h, 20 items: E8S, E8W, compare, dump, single_ratio, trace. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-E8P2_COMMIT_AT_SUBMISSION}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-e8p2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-10781f23663c3c3b8c95cbe7235c3fa7653b07aa}
export E7_ARMS=${E7_ARMS:-C}
export E7_RAW=${E7_RAW:-1}
export E7_TRACE_DETAIL=${E7_TRACE_DETAIL:-full}
export E7_CONTINUE_ON_FAILURE=${E7_CONTINUE_ON_FAILURE:-1}
export E7_PARTITION_RECORD=${E7_PARTITION_RECORD:-1}
export E7_UNIFORM_POWER_CAP=${E7_UNIFORM_POWER_CAP:-1}
export E7_POWER_CAP_W=${E7_POWER_CAP_W:-575}
export E8_SINGLE_REPO=${E8_SINGLE_REPO:-$HOME/run/vulkan-demo-v7single}
source "${E30_REPO:-$HOME/run/vulkan-demo-e8}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin e8B B cavity2d_n1000 cavity3d_n152 cavity3d_n192 cavity3d_n192_k8 cavity3d_n244 cavity3d_n312 cavity3d_n392
e7_point E8S cavity3d_n152 8 5 1500 500 900 900 900 1 same:900
e7_extra dump dump_3d_n152_K1a cavity3d_n152 1 1500 0 900
e7_extra dump dump_3d_n152_K1b cavity3d_n152 1 1500 0 900
e7_extra dump dump_3d_n152_K8 cavity3d_n152 8 1500 0 900
e7_extra compare compare_3d_n152_K8 cavity3d_n152 8 1500 0 900
e7_extra trace trace_3d_n152_K1 cavity3d_n152 1 1500 500 900
e7_point E8S cavity3d_n192 8 5 1500 500 900 900 900 1 same:900
e7_extra dump dump_3d_n192_K1a cavity3d_n192 1 1500 0 900
e7_extra dump dump_3d_n192_K1b cavity3d_n192 1 1500 0 900
e7_extra dump dump_3d_n192_K8 cavity3d_n192 8 1500 0 900
e7_extra compare compare_3d_n192_K8 cavity3d_n192 8 1500 0 1080
e7_extra trace trace_3d_n192_K1 cavity3d_n192 1 1500 500 900
e7_point E8S cavity3d_n244 8 3 1500 500 900 900 900 1 same:960
e7_extra trace trace_3d_n244_K1 cavity3d_n244 1 1500 500 1020
e7_point E8S cavity3d_n312 8 3 1500 500 900 900 1020 1 same:1320
e7_extra trace trace_3d_n312_K1 cavity3d_n312 1 1500 500 1380
e7_point E8S cavity3d_n392 8 3 1500 500 1080 960 1260 1 same:1980
e7_extra trace trace_3d_n392_K1 cavity3d_n392 1 1500 500 2040
e7_point E8W cavity3d_n192_k8 8 3 1500 500 1020 960 1260 1 cavity3d_n192:900
e8_single_ratio single_3d_n192 cavity3d_n192 3 1500 500 1860
e7_job_end
