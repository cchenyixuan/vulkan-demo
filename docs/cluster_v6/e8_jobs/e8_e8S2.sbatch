#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=2
#SBATCH --time=02:00:00
#SBATCH -J e8_BS2
#SBATCH --dependency=singleton
#SBATCH --exclude=wqd10nbm13g5,wqd10nah09g1
#SBATCH -o /data/run01/scxm138/logs/e8_e8S2_%j.out
# E8 phase 2 re-measurement of the v7_single comparison (job 1722130's single halves ran without any defrag), Sec. 5.1 protocol + a bootstrap-defrag control pair, on tag e8-3d-p2s2 (generated by docs/cluster_v6/scripts/e7_plan.py --revision 15 --emit-jobs, line B; do not edit by hand).
# Estimate 0.37 h, 2 items: single_control, single_ratio. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-E8P2S2_COMMIT_AT_SUBMISSION}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-e8p2}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-10781f23663c3c3b8c95cbe7235c3fa7653b07aa}
export E7_ARMS=${E7_ARMS:-C}
export E7_RAW=${E7_RAW:-1}
export E7_CONTINUE_ON_FAILURE=${E7_CONTINUE_ON_FAILURE:-1}
export E7_UNIFORM_POWER_CAP=${E7_UNIFORM_POWER_CAP:-1}
export E7_POWER_CAP_W=${E7_POWER_CAP_W:-575}
export E7_EXPECTED_DEVICES=${E7_EXPECTED_DEVICES:-2}
export E8_SINGLE_REPO=${E8_SINGLE_REPO:-$HOME/run/vulkan-demo-v7single2}
source "${E30_REPO:-$HOME/run/vulkan-demo-e8s2}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin e8S2 B cavity2d_n1000 cavity3d_n192
e8_single_ratio single_3d_n192_cadence cavity3d_n192 3 2000 1000 2220 cadence
e8_single_control single_3d_n192_bd cavity3d_n192 1500 500 1080
e7_job_end
