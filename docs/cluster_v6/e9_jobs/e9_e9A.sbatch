#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=07:00:00
#SBATCH -J e9_A
#SBATCH --dependency=singleton
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --exclude=wqd10nbm13g5,wqd10nah09g1,wqd10nbj04g3,wqd10nbj04g5
#SBATCH -o /data/run01/scxm138/logs/e9_e9A_%j.out
# E9 (user 2026-10-27): E8 phase 2 again with the prefix defrag order (tag v7-rc4), 3-D cubic cavity (generated by docs/cluster_v6/scripts/e7_plan.py --revision 18 --emit-jobs, line A; do not edit by hand).
# Estimate 2.57 h, 4 items: E8K, E8W. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-E9_COMMIT_AT_SUBMISSION}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-e9}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-37f99f2b25f85f01e31f6915bddf12c43f743993}
export E7_ARMS=${E7_ARMS:-C}
export E7_RAW=${E7_RAW:-1}
export E7_TRACE_DETAIL=${E7_TRACE_DETAIL:-full}
export E7_CONTINUE_ON_FAILURE=${E7_CONTINUE_ON_FAILURE:-1}
export E7_PARTITION_RECORD=${E7_PARTITION_RECORD:-1}
export E7_UNIFORM_POWER_CAP=${E7_UNIFORM_POWER_CAP:-1}
export E7_POWER_CAP_W=${E7_POWER_CAP_W:-575}
export E8_SINGLE_REPO=${E8_SINGLE_REPO:-$HOME/run/vulkan-demo-v7single-rc4}
source "${E30_REPO:-$HOME/run/vulkan-demo-e9}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin e9A A cavity2d_n1000 cavity3d_n192 cavity3d_n192_k2 cavity3d_n192_k4 cavity3d_n392
e7_point E8K cavity3d_n392 2 3 1500 500 1320 1380 1500 1 same:1980
e7_point E8K cavity3d_n392 4 3 1500 500 1140 1080 1260 1 same:1980
e7_point E8W cavity3d_n192_k2 2 3 1500 500 900 900 900 1 cavity3d_n192:900
e7_point E8W cavity3d_n192_k4 4 3 1500 500 900 900 960 1 cavity3d_n192:900
e7_job_end
