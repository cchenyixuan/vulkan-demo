#!/bin/bash
#SBATCH -p hp_5090
#SBATCH -A hp5090
#SBATCH -N 1
#SBATCH --gpus=8
#SBATCH --time=05:00:00
#SBATCH -J e9_C
#SBATCH --dependency=singleton
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --exclude=wqd10nbm13g5,wqd10nah09g1,wqd10nbj04g3,wqd10nbj04g5
#SBATCH -o /data/run01/scxm138/logs/e9_e9C_%j.out
# E9 line C (user 2026-10-27): the 128M cube at K = 8 with K = 2 pair references again, prefix defrag order (tag v7-rc4) (generated by docs/cluster_v6/scripts/e7_plan.py --revision 19 --emit-jobs, line C; do not edit by hand).
# Estimate 1.50 h, 2 items: E8S, trace. The protocol is e7_lib.sh's.
export E30_EXPECT_COMMIT=${E30_EXPECT_COMMIT:-E9_COMMIT_AT_SUBMISSION}
export E7_SOLVER_TAG=${E7_SOLVER_TAG:-e9}
export E7_EXPECTED_TREE=${E7_EXPECTED_TREE:-37f99f2b25f85f01e31f6915bddf12c43f743993}
export E7_ARMS=${E7_ARMS:-C}
export E7_RAW=${E7_RAW:-1}
export E7_TRACE_DETAIL=${E7_TRACE_DETAIL:-full}
export E7_CONTINUE_ON_FAILURE=${E7_CONTINUE_ON_FAILURE:-1}
export E7_PARTITION_RECORD=${E7_PARTITION_RECORD:-1}
export E7_UNIFORM_POWER_CAP=${E7_UNIFORM_POWER_CAP:-1}
export E7_POWER_CAP_W=${E7_POWER_CAP_W:-575}
source "${E30_REPO:-$HOME/run/vulkan-demo-e9}/docs/cluster_v6/scripts/e7_lib.sh" || { echo "ABORT: no e7_lib.sh"; exit 2; }
e7_job_begin e9C C cavity2d_n1000 cavity3d_n496
e7_point E8S cavity3d_n496 8 3 1500 500 1440 1260 1860 1 pairs:2160
e7_extra trace trace_3d_n496_K2 cavity3d_n496 2 1500 500 2340
e7_job_end
